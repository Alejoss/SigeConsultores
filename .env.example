# Copia este archivo a .env o .env.local en la raíz del repo (el servidor carga .env y luego .env.local con prioridad).
# Obligatorias para arrancar el servidor (validateOAuthConfig):
#   VITE_APP_ID, OAUTH_SERVER_URL, JWT_SECRET
# Para datos reales necesitas MySQL y DATABASE_URL.

VITE_APP_ID=proj_abc123def456
VITE_OAUTH_PORTAL_URL=https://vida.butterfly-effect.dev
# Opcional: analytics Umami (solo se carga el script si ambas están definidas).
# VITE_ANALYTICS_ENDPOINT=https://analytics.manus.im
# VITE_ANALYTICS_WEBSITE_ID=tu-website-id
OAUTH_SERVER_URL=https://vidabiz.butterfly-effect.dev
# Docker local (docker-compose.yml):
#   user: sige
#   password: sige
#   db: sige_platform
# Levanta MySQL: docker compose up -d
# Explorador Drizzle (lee .env / .env.local): pnpm run db:studio
DATABASE_URL=mysql://sige:sige@localhost:3306/sige_platform
JWT_SECRET=your-jwt-secret-change-in-production
OPENAI_API_URL=
OPENAI_API_KEY=your-openai-api-key
# AWS S3 — shared bucket for backups + file uploads (uploads go under "uploads/" prefix)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-2
AWS_S3_BUCKET=sige-backups
# Infrastructure (server-only)
PORT=3000
