# --- Docker Compose en tu PC o en el servidor ---
# Compose sustituye ${MYSQL_USER}, ${APP_IMAGE}, etc. desde:
#   - un archivo .env en la raíz del repo, o
#   - el mismo archivo explícito:  docker compose --env-file .env.staging ...
# (env_file: solo inyecta variables *dentro* de los contenedores; no basta para ${...} en el YAML.)
#
# Imagen del servicio app (construye antes: docker build -t sige-staging:local .)
APP_IMAGE=sige-staging:local

MYSQL_ROOT_PASSWORD=change-me-staging
MYSQL_DATABASE=sige_platform_staging
MYSQL_USER=sige
MYSQL_PASSWORD=change-me-staging

# Para CLI en el host (pnpm db:studio, pnpm run admin:create): no hace falta DATABASE_URL si defines host/puerto del túnel al contenedor mysql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# Opcional: DATABASE_URL explícita (si existe, tiene prioridad sobre MYSQL_*).
# En el contenedor `app`, Compose inyecta DATABASE_URL solo por variables de entorno.

VITE_APP_ID=proj_abc123def456
VITE_OAUTH_PORTAL_URL=https://vida.butterfly-effect.dev
OAUTH_SERVER_URL=https://vidabiz.butterfly-effect.dev
JWT_SECRET=change-me-staging-long-random-string
OWNER_OPEN_ID=
FRONTEND_URL=https://staging.your-domain.com
# AWS S3 — shared bucket for backups + file uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-2
AWS_S3_BUCKET=sige-backups
PORT=3000
