# Imagen del servicio app (docker-compose.prod.yml). Local en droplet: sige-prod:local
# GHCR: ghcr.io/Alejoss/SigeConsultores:latest o :<commit-sha>
APP_IMAGE=sige-prod:local

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=sige_platform
MYSQL_USER=sige
MYSQL_PASSWORD=change-me

VITE_APP_ID=proj_abc123def456
VITE_OAUTH_PORTAL_URL=https://vida.butterfly-effect.dev
OAUTH_SERVER_URL=https://vidabiz.butterfly-effect.dev
JWT_SECRET=change-me-long-random-string
OWNER_OPEN_ID=
FRONTEND_URL=https://your-domain.com
# AWS S3 — shared bucket for backups + file uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-2
AWS_S3_BUCKET=sige-backups
PORT=3000
