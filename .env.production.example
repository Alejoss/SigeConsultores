# Imagen del servicio app (docker-compose.prod.yml). Solo en el servidor — no commitear .env.production.
# GHCR (flujo habitual): :latest = último build en main; :<sha> = versión fija (reproducible).
APP_IMAGE=ghcr.io/alejoss/sigeconsultores:latest
GHCR_USERNAME=
GHCR_TOKEN=

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=sige_platform
MYSQL_USER=sige
MYSQL_PASSWORD=change-me

VITE_APP_ID=proj_abc123def456
VITE_OAUTH_PORTAL_URL=https://vida.butterfly-effect.dev
OAUTH_SERVER_URL=https://vidabiz.butterfly-effect.dev
JWT_SECRET=change-me-long-random-string
OWNER_OPEN_ID=
# Dominio público oficial de ISGE 360
FRONTEND_URL=https://isge360.com
VITE_FRONTEND_URL=https://isge360.com
# Amazon SES — correo transaccional. Región distinta de S3 (Ohio).
AWS_SES_REGION=us-west-2
SES_FROM_EMAIL=noreply@isge360.com
SES_FROM_NAME=ISGE 360
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# AWS S3 — shared bucket for backups + file uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-2
AWS_S3_BUCKET=sige-backups
PORT=3000
